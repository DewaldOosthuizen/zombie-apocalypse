[sub_resource type="GDScript" id="1"]
script/source = "extends \"res://scripts/generic_character_behaviour.gd\"

func _ready():
	player_sprite = get_node(\"AnimatedSprite\")
	if (!get_tree().root.is_queued_for_deletion()):
		super._setup_collision() # set up collision shapes
		# STAT OWNERSHIP: starting ammo, energy, and health are intentionally
		# set via @export Inspector values serialised in this .tscn file
		# (e.g. ammo = 10 in the node properties below). The base-class
		# defaults in generic_character_behaviour.gd are fallbacks only.
		# Un-comment the lines below ONLY if you want code to override
		# the Inspector values at runtime.
#		ammo = 10 # starting ammo
#		energy = 0 # starting energy
#		health = 100 # starting health
#		main_character = true # is main character
#		action1_damage = 40
#		action2_damage = 20
#		action3_damage = 10
		velocity = Vector2(0, 0)
		facing_direction = 1
		movement_direction = 1
		type = \"robot\"
		super._change_sprite_animation(\"idle\")
		bullet_scene = preload(\"res://scenes/characters/robot/Bullet_Scene.tscn\")
		blood_colour = Color(\"#0a0a0a\") # black
		
		super._emit_character_ready()
		super._subscribe_to_signals()
		print(\":: \" + type + \" character spawed ::\")


func _physics_process(delta):
	# check for character control
	control_character(delta)
	super._start_process(delta)
	if (health > 0):
		super._area_checks()


func control_character(delta):
	# reset default behaviour
	super._reset_character_sprite_states(delta)
	
	# Handle input events
	if (!dazed and health > 0):
		if (Input.is_action_just_pressed(\"action_1\") and !action1 and !action2 and !action3 and ammo > 0):
			super._shoot_bullet(2)
			repeat_frames = false;
			
			if (current_jump_count > 0):
				super._change_sprite_animation(\"jump_shoot\")
			elif (movement_direction != 0):
				super._change_sprite_animation(\"run_shoot\")
			elif (movement_direction == 0):
				super._change_sprite_animation(\"shoot\")
		
			super._emit_refresh_hud()
		elif (Input.is_action_just_pressed(\"action_2\") and !action1 and !action2 and !action3):
			action2 = true
			repeat_frames = false;
			super._melee_attack_collision()
			if (current_jump_count > 0):
				super._change_sprite_animation(\"jump_melee\")
			else:
				super._change_sprite_animation(\"melee\")
				
		elif (Input.is_action_just_pressed(\"action_3\") and movement_direction != 0 and !action3):
			action3 = true
			repeat_frames = false;
			super._change_sprite_animation(\"slide\")
			super._slide_attack_collision()
		elif (Input.is_action_just_pressed(\"move_jump\") and current_jump_count < max_jump_count and !action3):
			player_speed_y = -JUMPFORCE
			current_jump_count += 1
			super._change_sprite_animation(\"jump\")
			player_sprite.frame = 0
			repeat_frames = false
			action1 = false
			action2 = false
			action3 = false
		elif (Input.is_action_pressed(\"move_left\")):
			super._move_left()
		elif (Input.is_action_pressed(\"move_right\")):
			super._move_right()
		elif (Input.is_action_pressed(\"respawn\")):
			super._emit_reposition()
		else:
			movement_direction = 0
			if (health <= 0):
				super._change_sprite_animation(\"dead\")
				repeat_frames = false
			elif (current_jump_count == 0 and !action1 and !action2 and !action3):
				super._change_sprite_animation(\"idle\")
				repeat_frames = true
"

